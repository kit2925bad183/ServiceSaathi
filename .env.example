# ==========================================
# ServiceSaathi - Environment Configuration
# ==========================================

# Application
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000

# Session & Security
# Generate with: openssl rand -base64 32
SESSION_SECRET=servicesaathi-super-secure-session-secret-at-least-32-chars-long!
SESSION_MAX_AGE_DAYS=14

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/servicesaathi_dev?schema=public
# Direct URL used for Prisma CLI migrations if pooler is used
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/servicesaathi_dev?schema=public

# Cache & Background Queue (Redis)
REDIS_URL=redis://localhost:6379

# Storage (S3 / MinIO compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=servicesaathi-uploads
S3_FORCE_PATH_STYLE=true

# Development Email (Mailpit / SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ServiceSaathi <no-reply@servicesaathi.local>"

# Payment Provider Adapter (Razorpay Sandbox)
# When empty or using rzp_test_placeholder, sandbox mock adapter handles simulation
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# External Messaging Adapter (SMS / WhatsApp)
# Defaults to in-memory/logger adapter if unset
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_ACCESS_TOKEN=mock_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=mock_phone_number_id

# Optional AI Voice Drafts Feature Flag
AI_VOICE_FEATURE_ENABLED=false
GEMINI_API_KEY=
